[gd_scene format=3]

[ext_resource type="Script" path="res://Cenas/tela_final.gd" id="1_tela"]

[node name="TelaFinal" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_tela")

[node name="Fundo" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.45, 0.12, 0.12, 1)

[node name="Caixa" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -150.0
offset_right = 300.0
offset_bottom = 150.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 24

[node name="Titulo" type="Label" parent="Caixa"]
layout_mode = 2
theme_override_font_sizes/font_size = 64
text = "FIM DE JOGO"
horizontal_alignment = 1

[node name="Subtitulo" type="Label" parent="Caixa"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "As encomendas não chegaram a tempo..."
horizontal_alignment = 1

[node name="Jogar" type="Button" parent="Caixa"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "JOGAR DE NOVO"

[node name="Menu" type="Button" parent="Caixa"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "MENU"

[connection signal="pressed" from="Caixa/Jogar" to="." method="_on_jogar_pressed"]
[connection signal="pressed" from="Caixa/Menu" to="." method="_on_menu_pressed"]
